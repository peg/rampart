vars: {
  d2-config: {
    theme-id: 200
  }
}

direction: down

agent: "Agent tool request" {
  style.border-radius: 8
}

boundary: "Configured integration\nhook, plugin, proxy or wrapper" {
  style.border-radius: 8
}

engine: "YAML policy engine\nlocal matching" {
  style.fill: "#33232c"
  style.stroke: "#ff8fbc"
  style.font-color: "#f1ede7"
  style.border-radius: 8
}

outcomes: {
  label: "Decision returned to the integration"
  allow: "Allow / watch\nhost may continue" {
    style.border-radius: 8
  }
  deny: "Deny\nblock represented action" {
    style.border-radius: 8
  }
  ask: "Ask\nhuman approval required" {
    style.fill: "#33232c"
    style.stroke: "#ff8fbc"
    style.font-color: "#f1ede7"
    style.border-radius: 8
  }
}

audit: "Local audit trail\npolicy decision and request" {
  style.border-radius: 8
}

agent -> boundary: "exposed action"
boundary -> engine
engine -> outcomes.allow: "allow / watch"
engine -> outcomes.deny: "deny"
engine -> outcomes.ask: "ask"
engine -> audit: "record decision"
