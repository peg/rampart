{
  "id": "rampart",
  "name": "Rampart",
  "description": "Independent safety guard for unattended AI agent actions",
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "hook"
    ]
  },
  "version": "1.4.0",
  "author": "peg",
  "homepage": "https://rampart.sh",
  "repository": "https://github.com/peg/rampart",
  "hooks": [
    "before_tool_call"
  ],
  "minHostVersion": "2026.3.28",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serveUrl": {
        "type": "string",
        "default": "http://localhost:9090"
      },
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "timeoutMs": {
        "type": "number",
        "default": 3000,
        "minimum": 100,
        "maximum": 30000
      },
      "failOpen": {
        "type": "boolean",
        "description": "Deprecated coarse degraded-mode switch. Set true only to opt lower-risk tools into degraded fail-open behavior. Prefer failOpenTools for per-tool control.",
        "default": false
      },
      "failOpenTools": {
        "type": "array",
        "description": "Tool names that may proceed when Rampart serve is unavailable or returns an evaluation error. Sensitive tools should normally be omitted.",
        "default": [],
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "approvalTimeoutMs": {
        "type": "number",
        "default": 120000,
        "minimum": 10000,
        "maximum": 600000
      }
    }
  }
}
